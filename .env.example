# Frontend build: public values only. Configure Preview separately in Vercel.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Backend secret in Supabase ONLY; never set service-role keys in the frontend.
# KHIPU_INVITE_REDIRECT_URL=https://YOUR_PREVIEW_HOST/restablecer.html
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied to
# Supabase Edge Functions by the platform. Never commit their real values.
# Text AI: set GEMINI_API_KEY in Supabase > Edge Functions > Secrets only.
# Optional server-only GEMINI_TEXT_MODEL; default: gemini-3.5-flash-lite.
# These are not frontend/Vercel environment variables.
# Image editing: POLLINATIONS_API_KEY in Supabase secrets only (sk_ key).
# Fixed pilot model: black-forest-labs/flux.2-klein-4b. Each request consumes Pollen.
